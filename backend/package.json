{
  "name": "wp-back",
  "version": "1.0.0",
  "main": "dist/server.js",
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && babel src --out-dir dist --extensions \".js\"",
    "prestart": "npm run build",
    "start": "cross-env NODE_ENV=production node ./dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "dev:debug": "cross-env NODE_ENV=development nodemon --legacy-watch --config nodemon.debug.json",
    "docker:dev": "docker-compose -f ../../docker-compose.yml -f ./containers/docker-compose.dev.yml up",
    "docker:debug": "docker-compose -f ../../docker-compose.yml -f ./containers/docker-compose.override.yml up",
    "docker:build": "docker-compose exec backend npm run build",
    "docker:start": "docker-compose exec backend npm start",
    "install:back": "docker compose exec backend npm install",
    "add:back": "docker compose exec backend npm install",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f backend",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "keywords": [],
  "description": "",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "content-disposition": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.1",
    "dotenv-safe": "^9.1.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^8.1.8",
    "lru-cache": "^11.2.5",
    "mysql2": "^3.15.1",
    "odbc": "^2.4.9",
    "p-limit": "^7.3.3",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "tar": ">=7.5.7"
  }
}
